# Dedicated monitoring server (SSH / Kamal host).
MONITOR_HOST=CHANGE_ME

# Public hostname for Grafana (Let's Encrypt via kamal-proxy).
GRAFANA_HOST=grafana.example.com

# DigitalOcean Container Registry token (same pattern as hra-ocr).
KAMAL_REGISTRY_TOKEN=

# Grafana admin login (change after first login).
GRAFANA_ADMIN_PASSWORD=

# Shared bearer token for /metrics scrape. Use the same value in each Rails app.
PROMETHEUS_METRICS_TOKEN=

# Optional Alertmanager email (leave blank to keep a no-op receiver).
ALERT_SMTP_FROM=
ALERT_SMTP_TO=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USERNAME=
ALERT_SMTP_PASSWORD=

# Optional Alertmanager Telegram.
ALERT_TELEGRAM_BOT_TOKEN=''
ALERT_TELEGRAM_CHAT_ID=
