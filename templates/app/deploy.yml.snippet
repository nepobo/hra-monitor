# Snippets to merge into config/deploy.yml of the Rails app.
# Web /metrics is scraped over the existing HTTPS kamal-proxy host.
# Sidekiq roles publish unique host ports because several workers share a machine.

# env:
#   clear:
#     PROMETHEUS_METRICS_PORT: "9394"
#     PROMETHEUS_METRICS_BIND: "0.0.0.0"
#   secret:
#     - PROMETHEUS_METRICS_TOKEN

