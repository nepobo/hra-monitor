#       publish:
#         - "9394:9394"

# Boot node-exporter ONCE per host, not once per role / app.
# If another Kamal app already runs node-exporter on the host, skip this.
#
# accessories:
#   node_exporter:
#     image: prom/node-exporter:v1.9.1
#     hosts:
#       - 64.23.190.193
#       - 24.144.91.119
#       - 146.190.161.149
#     network: host
#     volumes:
#       - "/:/host:ro,rslave"
#     options:
#       pid: host
#     cmd: --path.rootfs=/host --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host/sys|host/proc|host/dev|host/run)($|/)

