#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=bin/_lib.sh
source "$(cd "$(dirname "$0")" && pwd)/_lib.sh"

run_ruby bin/render.rb
require_deploy_env

echo "Rebooting Prometheus accessories so Kamal re-uploads generated file_sd and alert rules."
echo "TSDB data stays in the prometheus_data volume."

run_kamal accessory reboot prometheus
run_kamal accessory reboot alertmanager
run_kamal accessory reboot blackbox

echo
echo "Accessories reloaded."
echo "If Grafana dashboards or provisioning changed, run: bin/kamal deploy"
